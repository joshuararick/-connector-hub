# Local secrets and generated credentials
*DO-NOT-COMMIT*
*.env
!.env.example
backend/ANTHROPIC_API_KEY=*
backend/*.env
backend/*secret*
backend/*token*

# Drop archives and local handoff payloads
*.zip
agent-maker-sync-handoff/source_drop_here/**
!agent-maker-sync-handoff/source_drop_here/.gitkeep

# Local runtime logs
*.log
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.vscode/
.codex-*.pid

# Agent runtime memory
.agent_memory.jsonl
